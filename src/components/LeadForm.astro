---
const ages = ['Di bawah 22 tahun', '22-25 tahun', '26-30 tahun', '31-35 tahun', 'Di atas 35 tahun'];
const experiences = ['Belum memiliki pengalaman', 'Kurang dari 1 tahun', '1-2 tahun', '3-5 tahun', 'Lebih dari 5 tahun'];
const goals = [
  'Mendapatkan pekerjaan baru di perusahaan yang lebih baik',
  'Pindah ke bidang pekerjaan yang lebih sesuai',
  'Mendapatkan kenaikan gaji',
  'Mendapatkan promosi / naik jabatan',
  'Naik jabatan sekaligus mendapatkan kenaikan gaji.',
  'Lainnya',
];
const steps = ['Kontak', 'Profil Karier', 'CV / LinkedIn'];
const points = [
  'Optimasi CV, LinkedIn, dan Personal Branding secara Berkala',
  'Pendampingan Aktif Mulai dari HR Interview hingga Penawaran Kerja',
  'Konsultasi 1-on-1 Bersama Domain Specialist',
];

const check =
  '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l3 3 5-6"/></svg>';
---

<header class="lf-bar">
  <div class="lf-bar-in">
    <a href="/job-placement-program" aria-label="Dibimbing, kembali ke halaman program">
      <img src="https://dibimbing-cdn.sgp1.cdn.digitaloceanspaces.com/logo-dibimbing.webp" alt="dibimbing" width="135" height="27" />
    </a>
    <a class="lf-back" href="/job-placement-program">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
      Kembali<span class="lf-back-long"> ke halaman program</span>
    </a>
  </div>
</header>

<div class="lf">
  <aside class="lf-aside">
    <div class="lf-aside-in">
      <span class="lf-pill">Seleksi Program</span>
      <h1 class="lf-title">Dapatkan Karier Impianmu, <span>Tanpa Risiko</span></h1>
      <p class="lf-lede">Garansi kerja dalam <strong>6 bulan</strong> dan jaminan <strong>refund 100%</strong>. Ceritakan tujuan kariermu dalam 3 langkah singkat, lalu Personal Advisor kami siap menghubungimu via WhatsApp.</p>
      <ul class="lf-points">
        {points.map((p) => <li><Fragment set:html={check} />{p}</li>)}
      </ul>
    </div>
  </aside>

  <main class="lf-main" id="daftar">
    <div class="lf-card">
      <form class="lf-form" novalidate autocomplete="on">
        <ol class="lf-steps" aria-label="Langkah pengisian">
          {steps.map((s, i) => (
            <li class="lf-stepind" data-ind={i + 1} aria-current={i === 0 ? 'step' : undefined}>
              <span class="lf-dot"><span class="lf-dot-n">{i + 1}</span><svg class="lf-dot-ok" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
              <span class="lf-stepname">{s}</span>
            </li>
          ))}
        </ol>

        <!-- Step 1 -->
        <div class="lf-panel" data-step="1" role="group" aria-labelledby="lf-h1">
          <h2 class="lf-h" id="lf-h1" tabindex="-1">Kenalan dulu, yuk</h2>
          <div class="lf-field" data-field="name">
            <label class="lf-label" for="lf-name">Nama lengkap</label>
            <input class="lf-input" id="lf-name" name="name" type="text" autocomplete="name" placeholder="Contoh: Budi Santoso" required />
            <p class="lf-error" id="lf-name-err" hidden></p>
          </div>
          <div class="lf-field" data-field="wa">
            <label class="lf-label" for="lf-wa">Nomor WhatsApp aktif</label>
            <input class="lf-input" id="lf-wa" name="wa" type="tel" inputmode="tel" autocomplete="tel" placeholder="Contoh: 0812 3456 7890" required aria-describedby="lf-wa-hint lf-wa-err" />
            <p class="lf-hint" id="lf-wa-hint">Advisor kami akan menghubungimu lewat nomor ini.</p>
            <p class="lf-error" id="lf-wa-err" hidden></p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="lf-panel" data-step="2" role="group" aria-labelledby="lf-h2" hidden>
          <h2 class="lf-h" id="lf-h2" tabindex="-1">Ceritakan profil kariermu</h2>

          <div class="lf-row">
            <div class="lf-field" data-field="age">
              <label class="lf-label" for="lf-age">Usia kamu saat ini</label>
              <span class="lf-select">
                <select class="lf-input" id="lf-age" name="age" required>
                  <option value="" disabled selected>Pilih rentang usia</option>
                  {ages.map((a) => <option value={a}>{a}</option>)}
                </select>
              </span>
              <p class="lf-error" hidden></p>
            </div>

            <div class="lf-field" data-field="exp">
              <label class="lf-label" for="lf-exp">Pengalaman kerja profesional</label>
              <span class="lf-select">
                <select class="lf-input" id="lf-exp" name="exp" required>
                  <option value="" disabled selected>Pilih lama pengalaman</option>
                  {experiences.map((a) => <option value={a}>{a}</option>)}
                </select>
              </span>
              <p class="lf-error" hidden></p>
            </div>
          </div>

          <div class="lf-field" data-field="job">
            <label class="lf-label" for="lf-job">Apa pekerjaan kamu saat ini?</label>
            <input class="lf-input" id="lf-job" name="job" type="text" autocomplete="organization-title" placeholder="Contoh: Marketing Executive" required />
            <p class="lf-error" hidden></p>
          </div>

          <div class="lf-field" data-field="target">
            <label class="lf-label" for="lf-target">Apa posisi / jabatan yang ingin kamu capai selanjutnya?</label>
            <input class="lf-input" id="lf-target" name="target" type="text" placeholder="Contoh: Senior Marketing" required />
            <p class="lf-error" hidden></p>
          </div>

          <div class="lf-field" data-field="goal" role="radiogroup" aria-labelledby="lf-goal-l">
            <span class="lf-label" id="lf-goal-l">Apa tujuan kamu mengikuti Dibimbing Placement Program?</span>
            <div class="lf-opts">
              {goals.map((g) => (
                <label class="lf-opt"><input type="radio" name="goal" value={g} /><span>{g}</span></label>
              ))}
            </div>
            <div class="lf-other" hidden>
              <label class="lf-label lf-label--sm" for="lf-goal-other">Tuliskan tujuanmu</label>
              <input class="lf-input" id="lf-goal-other" name="goalOther" type="text" placeholder="Tujuan lain yang ingin kamu capai" />
            </div>
            <p class="lf-error" hidden></p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="lf-panel" data-step="3" role="group" aria-labelledby="lf-h3" hidden>
          <h2 class="lf-h" id="lf-h3" tabindex="-1">Terakhir, lampirkan CV atau profil LinkedIn-mu</h2>
          <p class="lf-hint lf-hint--lead" id="lf-cv-any">Isi salah satu atau keduanya.</p>
          <p class="lf-error" id="lf-cv-any-err" hidden></p>

          <div class="lf-field" data-field="cv">
            <label class="lf-label" for="lf-cv">Link CV / resume (Google Drive)</label>
            <input class="lf-input" id="lf-cv" name="cv" type="text" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="https://drive.google.com/file/d/..." aria-describedby="lf-cv-hint lf-cv-err" />
            <p class="lf-hint" id="lf-cv-hint">Unggah CV ke Google Drive, klik <strong>Bagikan</strong>, lalu ubah akses ke <strong>“Siapa saja yang memiliki link”</strong> agar advisor bisa membukanya.</p>
            <p class="lf-error" id="lf-cv-err" hidden></p>
          </div>

          <div class="lf-field" data-field="linkedin">
            <label class="lf-label" for="lf-linkedin">Link profil LinkedIn</label>
            <input class="lf-input" id="lf-linkedin" name="linkedin" type="text" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="linkedin.com/in/namamu" aria-describedby="lf-linkedin-hint lf-linkedin-err" />
            <p class="lf-hint" id="lf-linkedin-hint">Pastikan profilmu bisa dilihat publik agar advisor bisa membukanya.</p>
            <p class="lf-error" id="lf-linkedin-err" hidden></p>
          </div>
        </div>

        <div class="lf-actions">
          <button type="button" class="lf-btn lf-btn--ghost" data-act="back" hidden>Kembali</button>
          <button type="button" class="lf-btn lf-btn--primary" data-act="next">Lanjut</button>
          <button type="submit" class="lf-btn lf-btn--primary" data-act="submit" hidden>Kirim &amp; Lanjut ke WhatsApp</button>
        </div>
      </form>

      <div class="lf-done" hidden tabindex="-1" aria-live="polite">
        <span class="lf-done-icon"><Fragment set:html={check} /></span>
        <h2 class="lf-h">Terima kasih, <span data-done-name>kamu</span>!</h2>
        <p class="lf-sub">Datamu sudah kami susun. Kamu sedang dialihkan ke WhatsApp untuk melanjutkan percakapan dengan tim Dibimbing. Jika tidak terbuka otomatis, klik tombol di bawah.</p>
        <div class="lf-actions lf-actions--center">
          <a class="lf-btn lf-btn--primary" data-done-link href="#">Buka WhatsApp</a>
          <button type="button" class="lf-btn lf-btn--ghost" data-act="reset">Isi ulang</button>
        </div>
      </div>
    </div>
  </main>
</div>
